# ============================================================================
# SSD 复现 —— Git 忽略清单
# 注意：Git 的 .gitignore **不支持行内注释**，注释必须独占一行！
# ============================================================================

# --- 环境与缓存（体积大）---------------------------------------------------
# macOS 的 conda 环境，1.1GB，Linux 上也没有用
env_ssd/
# 预训练权重 / matplotlib 字体缓存，529MB
.cache/
__pycache__/
*.pyc
.DS_Store

# --- 数据集（1.7GB）--------------------------------------------------------
# 云服务器上用 脚本/00_云服务器初始化.sh 自动下载
数据集/

# --- 训练产出（每个权重 200MB+）--------------------------------------------
experiments/
*.pth
train.log

# --- 官方 Caffe 代码（38MB）------------------------------------------------
# 原因：
#   1. 里面有一个嵌套的 .git 仓库（12MB），直接提交会变成坏掉的 submodule
#   2. 是 Wei Liu 的官方 Caffe 实现，上游公开可取，云端训练也用不到
#   3. 本地保留即可，README / 报告里引用它的路径
# 如果想把它也提交：删掉本行，并先删除 代码/01_官方原始仓库_caffe_ssd分支/.git
代码/

# --- 本地临时产物 -----------------------------------------------------------
_dsh_acp_test/
*.log
